{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run check:deploy"
  },
  "deploy": {
    "startCommand": "NODE_ENV=production npm -w @pagent/api run start",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
