# NODE_ENV gates production-only checks like the ALLOWED_ORIGINS and public URL
# "must be set" refinements. The Node runtime sets this
# automatically on most platforms (Railway, Vercel) — leave unset for
# local dev. Valid values: development, production, test.
NODE_ENV=development

# Port the server listens on. Railway sets this automatically; for local dev, default 8787.
PORT=8787

# The public URL where users open pages in their browser.
# In dev: http://localhost:8788 (the Vite renderer, NOT the API on 8787).
# In prod: your Vercel deployment URL (e.g. https://pagent.link).
# Required when NODE_ENV=production — boot will fail loudly otherwise.
PUBLIC_URL=http://localhost:8788

# The externally reachable API origin used for OAuth issuer/discovery,
# callbacks, magic links, and MCP protected-resource metadata.
# In dev this defaults to http://localhost:${PORT} when unset.
# Required when NODE_ENV=production and must be an HTTPS origin.
API_PUBLIC_URL=http://localhost:8787

# How long pages live, in milliseconds (default 30 minutes).
PAGE_TTL_MS=1800000

# Comma-separated exact renderer origins for CORS and protected HTML document frames.
# HTML frames require this in EVERY environment; missing or mismatched origins return 403.
# Use the browser's actual origin (localhost and 127.0.0.1 differ). Production boot also
# requires this setting; set to your Vercel origin, e.g. https://pagent.link.
ALLOWED_ORIGINS=http://localhost:8788

# Supabase Postgres connection string (Session pooler, port 5432). In
# production, sslmode=disable is rejected; the API always uses verify-full.
# Dashboard → Project Settings → Database → Connection string → URI mode → Session pooler.
# URL-encode special chars in the password ($ → %24, @ → %40, etc).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase uses its own public root CA. Set this before starting Node so the
# existing verify-full database policy can authenticate the pooler certificate.
# Local (from apps/api): ./certs/supabase-prod-ca-2021.crt
# Railway: /app/apps/api/certs/supabase-prod-ca-2021.crt
NODE_EXTRA_CA_CERTS=./certs/supabase-prod-ca-2021.crt

# Observability — OpenTelemetry (optional).
# Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to disable OTel entirely.
# When set, the API exports three signals to <endpoint>:
#   - traces  → <endpoint>/v1/traces
#   - metrics → <endpoint>/v1/metrics
#   - logs    → <endpoint>/v1/logs (via pino-opentelemetry-transport)
#
# Self-hosted (Railway): the LGTM service's internal address, e.g.
#   http://pagent-observability.railway.internal:4318
# Grafana Cloud: the OTLP HTTP gateway URL (the value before /v1/traces).
#   Example: https://otlp-gateway-prod-us-central-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=

# Comma-separated key=value pairs. For Grafana Cloud:
#   Authorization=Basic <base64(instance_id:api_token)>
# Self-hosted on Railway's private network: leave empty.
OTEL_EXPORTER_OTLP_HEADERS=

# Identifies the service in Grafana. Default "pagent-api".
OTEL_SERVICE_NAME=pagent-api

# Log level: fatal | error | warn | info | debug | trace. Default info.
LOG_LEVEL=info

# Per-client-IP, in-memory write limit for temporary page creation and public
# viewer access/visit starts. Engagement delivery allows 4x this IP cap, plus
# 30 requests per viewer session per window and at most 10 events per request.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Trusted ingress contract for rate-limit IP attribution. Railway supplies
# X-Real-IP for the connecting client; Pagent ignores X-Forwarded-For.
# Required in production after verifying the staging ingress path. Do not set
# this mode when the API is directly reachable without Railway's edge.
TRUSTED_PROXY_MODE=

# --- Auth (OAuth 2.1 + sessions) ---------------------------------------------
# Durable presentation writes and analytics reads always require authentication.
# REQUIRE_AUTH=false permits anonymous temporary page writes and response reads
# during rollout grace mode. Invalid credentials still fail closed. OAuth routes
# remain mounted; flows needing unconfigured providers (such as SMTP) fail closed.
# When REQUIRE_AUTH=true, the following are required at boot or the server
# exits with a clear error: JWT_SIGNING_KEY, JWT_PUBLIC_KEY,
# AUTH_STATE_SECRET, SMTP_HOST, SMTP_USER, SMTP_PASS.
# See docs/superpowers/specs/2026-05-17-auth-design.md.

# Set to true to also require auth for temporary pages (e.g. POST /new).
# Leave false during the grace-period rollout.
REQUIRE_AUTH=false

# Ed25519 JWT keys for the access-token signer. Base64url-encoded DER bytes
# (generate with `openssl genpkey -algorithm ed25519`). Required when REQUIRE_AUTH=true.
JWT_SIGNING_KEY=
JWT_PUBLIC_KEY=

# Google OAuth 2.0 credentials (https://console.cloud.google.com/apis/credentials).
# Optional. When both are unset, the login page offers email magic links only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to {API_PUBLIC_URL}/oauth/callback/google when unset.
# When set in production, this URL must use HTTPS.
GOOGLE_REDIRECT_URI=

# HMAC key for OAuth state JWTs (e.g. `openssl rand -base64 32`).
# Required when REQUIRE_AUTH=true and must contain at least 32 UTF-8 bytes.
AUTH_STATE_SECRET=

# Token lifetimes (defaults match the auth spec).
SESSION_MAX_AGE_DAYS=30
REFRESH_TOKEN_MAX_DAYS=90
ACCESS_TOKEN_TTL_SECONDS=3600

# SMTP for sending magic-link emails. Required when REQUIRE_AUTH=true (except
# SMTP_PORT and SMTP_FROM, which have defaults). Resend uses smtp.resend.com,
# username `resend`, and an API key beginning with `re_` as the password.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=noreply@pagent.link
