# Port the server listens on. Railway sets this automatically; for local dev, default 8787.
PORT=8787

# The public URL where the renderer (apps/web) is hosted. Used in show_ui responses.
# In dev: http://localhost:8788. In prod: your Vercel deployment URL.
# Required when NODE_ENV=production — boot will fail loudly otherwise.
PUBLIC_URL=http://localhost:8788

# How long pages live, in milliseconds (default 30 minutes).
PAGE_TTL_MS=1800000

# Comma-separated list of origins allowed to call the API. Leave unset for dev (allows all).
# Required when NODE_ENV=production — boot will fail loudly otherwise. Set to your Vercel URL (e.g. https://pagent.vercel.app).
ALLOWED_ORIGINS=

# Supabase Postgres connection string (Session pooler, port 5432).
# Dashboard → Project Settings → Database → Connection string → URI mode → Session pooler.
# URL-encode special chars in the password ($ → %24, @ → %40, etc).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Observability — OpenTelemetry to Grafana Cloud (optional).
# Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to disable OTel entirely.
#
# Grafana Cloud → Observability → OpenTelemetry → Send Telemetry Data.
# Copy the OTLP HTTP gateway URL and paste here (the value before /v1/traces).
# Example: https://otlp-gateway-prod-us-central-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=

# Comma-separated key=value pairs. For Grafana Cloud:
#   Authorization=Basic <base64(instance_id:api_token)>
# Generate the token in Grafana Cloud → Connections → Send Data → OTLP.
OTEL_EXPORTER_OTLP_HEADERS=

# Identifies the service in Grafana traces. Default "pagent-api".
OTEL_SERVICE_NAME=pagent-api

# Log level: fatal | error | warn | info | debug | trace. Default info.
LOG_LEVEL=info

# Rate limiting on POST /new (per client IP, in-memory).
# Default: 30 requests per 60 seconds.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
