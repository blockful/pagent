# Port the server listens on. Railway sets this automatically; for local dev, default 8787.
PORT=8787

# The public URL where the renderer (apps/web) is hosted. Used in show_ui responses.
# In dev: http://localhost:8788. In prod: your Vercel deployment URL.
PUBLIC_URL=http://localhost:8788

# How long pages live, in milliseconds (default 30 minutes).
PAGE_TTL_MS=1800000

# Comma-separated list of origins allowed to call the API. Leave unset for dev (allows all).
# In prod, set to your Vercel deployment URL (e.g. https://pagent.vercel.app).
ALLOWED_ORIGINS=

# Supabase Postgres connection string (Session pooler, port 5432).
# Dashboard → Project Settings → Database → Connection string → URI mode → Session pooler.
# URL-encode special chars in the password ($ → %24, @ → %40, etc).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
