{
  "name": "agent-ui-session",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Hosted UI rendering service for terminal-bound AI agents",
  "scripts": {
    "dev:server": "node --watch --experimental-strip-types server.ts",
    "dev:client": "vite",
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "start": "node --experimental-strip-types server.ts",
    "build:client": "vite build"
  },
  "dependencies": {
    "@a2ui/lit": "file:../a2ui/renderers/lit",
    "@a2ui/web_core": "file:../a2ui/renderers/web_core",
    "@hono/node-server": "^1.13.7",
    "@lit-labs/signals": "^0.1.3",
    "@lit/context": "^1.1.4",
    "hono": "^4.6.14",
    "lit": "^3.3.1",
    "signal-utils": "^0.21.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
